# ---------------------------------------------------------------------------
# Email service configuration
# ---------------------------------------------------------------------------
# The app prefers HTTP-based email APIs because Railway blocks outbound SMTP.
# Set ONE of the following API keys. The first one found will be used.
#
# Resend (recommended) - https://resend.com - 3,000 free emails/month
RESEND_API_KEY=
#
# Brevo (Sendinblue)   - https://brevo.com   - 300 free emails/day
BREVO_API_KEY=
#
# SendGrid             - https://sendgrid.com - 100 free emails/day
SENDGRID_API_KEY=
#
# From address for outgoing email. Use your own verified domain in production.
# For Resend testing without a verified domain, leave blank to use
# 'Velare <onboarding@resend.dev>' (delivers only to the account owner).
EMAIL_FROM=
EMAIL_REPLY_TO=
#
# SMTP fallback (used locally; blocked on Railway). Optional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Other secrets - copy your real values here, keep this file out of git.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
FLASK_SECRET_KEY=
